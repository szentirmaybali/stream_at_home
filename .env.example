# ============================================================
# stream_at_home — környezeti változók
# A telepítő ebből másolja a .env-t, és legenerálja a DB_PASSWORD-t.
# A .env gitignored, chmod 600 — SOHA ne commitold!
# ============================================================

#időzóna és a meghajtón lévő fájlok tulajdonjoga
TZ=Europe/Budapest
PUID=1000
PGID=1000

# A befűzött adatmeghajtó (a VM-en /home/bali/media = nálam a /data)
MEDIA_ROOT=/home/bali/media

# Immich adatbázis
# A DB_PASSWORD-t az install.sh automatikusan lecseréli véletlenszerűre.
# Csak A-Za-z0-9 karakterek használhatók!
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
DB_PASSWORD=CHANGE_ME_INSTALL_GENERATES
