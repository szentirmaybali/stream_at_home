# ============================================================
# stream_at_home — environment template
# install.sh copies this to .env and generates DB_PASSWORD.
# .env is gitignored and chmod 600 — never commit it!
# ============================================================

# Timezone and ownership of files on the data drive.
# install.sh overwrites PUID/PGID with the invoking user's IDs and TZ with
# the system timezone when it creates this file.
TZ=Europe/Budapest
PUID=1000
PGID=1000

# Mount point of the data drive (appdata, media, torrents, Immich).
# Override at install time: MEDIA_ROOT=/mnt/media ./install.sh
MEDIA_ROOT=/srv/stream-at-home

# Immich database
# install.sh replaces DB_PASSWORD with a random value.
# Only A-Za-z0-9 characters are allowed!
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
DB_PASSWORD=CHANGE_ME_INSTALL_GENERATES
